{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-next-lab",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "env": {
    "production": {
      "name": "axecloud-site-home",
      "routes": [
        {
          "pattern": "axecloud.com.br/",
          "zone_name": "axecloud.com.br"
        },
        {
          "pattern": "axecloud.com.br/site-home-assets/*",
          "zone_name": "axecloud.com.br"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
