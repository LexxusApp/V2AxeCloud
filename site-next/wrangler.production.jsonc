{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-site-home",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "axecloud.com.br/",
      "zone_name": "axecloud.com.br"
    },
    {
      "pattern": "axecloud.com.br/site-home-assets/*",
      "zone_name": "axecloud.com.br"
    }
  ]
}