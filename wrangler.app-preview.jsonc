{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-app-preview",
  "main": "cloudflare/app-shell-worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": true,
  "vars": { "PREVIEW_MODE": "true" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}

