{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-app-assets",
  "main": "cloudflare/app-shell-worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PREVIEW_MODE": "false" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "axecloud.com.br/entrar*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/login*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/register*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/dashboard*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/checkout*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/assinatura*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/redefinir-senha*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/recuperar-senha*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/instrucoes*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/consulente*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/convite*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/checkin-portaria*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/checkin*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/presenca*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/widget*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/assets*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/brand*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/index.html*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/site.webmanifest*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/icon-*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/apple-touch-icon*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/og-image.png*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/sw.js*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/sw-push.js*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/sw-marketing-bypass.js*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/workbox-*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/manifest.webmanifest*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/build-info.json*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/pdf.worker.min.mjs*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/login-bg-desktop.png*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/axecloud_*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/axecloud-trident.png*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/pwa-*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/favicon.*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/logo-*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/ile-ase-logo.png*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/elemento-grafico-axecloud.png*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/notification-badge.png*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/whatsapp.svg*", "zone_name": "axecloud.com.br" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
