{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-admin-preview",
  "main": "cloudflare/admin-shell-worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./axecloud-admin/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "axecloud-api-staging"
    }
  ]
}
