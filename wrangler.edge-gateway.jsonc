{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-edge-gateway",
  "main": "cloudflare/edge-fallback-worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    { "binding": "HOME", "service": "axecloud-site-home" }
  ],
  "routes": [
    { "pattern": "axecloud.com.br/*", "zone_name": "axecloud.com.br" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}