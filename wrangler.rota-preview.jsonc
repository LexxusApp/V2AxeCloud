{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-rota-preview",
  "main": "cloudflare/rota-shell-worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../terreiro-visitas/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "axecloud-api-staging"
    }
  ]
}
