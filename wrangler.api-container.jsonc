{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-api-staging",
  "main": "cloudflare/api-container-worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "axecloud.com.br/api/health-check*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/ping*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/public-config*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/plans*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/tenant-info*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/auth/audit-log*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/auth/filho-login*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/children*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/events*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/notices*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/inventory*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/transactions*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/loja-pedidos*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/library*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/notifications*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/event-guests*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/push-subscribe*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/push-broadcast*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/push-direct*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/metrics/public-visit*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/metrics/conversion-event*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/landing/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/auth/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/filho/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/financial/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/library/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/gallery/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/preceitos*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/fundamentos*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/events/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/participacoes*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/frequencia*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/atendimentos/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/chat/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/gestao/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/settings/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/profile/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/account/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/support*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/store/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/store/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/obrigacao-pdf/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/event-banner*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/legal/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/onboarding/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/founder-program/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/api/v1/public/*", "zone_name": "axecloud.com.br" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "containers": [
    {
      "class_name": "AxeCloudApiContainer",
      "image": "./Dockerfile.cloudflare-api",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AXECLOUD_API_CONTAINER",
        "class_name": "AxeCloudApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AxeCloudApiContainer"]
    }
  ]
}
