{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-api-staging",
  "main": "cloudflare/api-container-worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "axecloud.com.br/api/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/webhook/*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/.well-known/api-catalog*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/openapi.json*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/auth.md*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/.well-known/auth.md*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/sitemap-terreiros.xml*", "zone_name": "axecloud.com.br" },
    { "pattern": "axecloud.com.br/sitemap-terreiros-*", "zone_name": "axecloud.com.br" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "services": [
    {
      "binding": "APP_ASSETS",
      "service": "axecloud-app-assets"
    },
    {
      "binding": "PROSPECT_API",
      "service": "axecloud-prospect-api"
    }
  ],
  "containers": [
    {
      "class_name": "AxeCloudApiContainer",
      "image": "./Dockerfile.cloudflare-api",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AXECLOUD_API_CONTAINER",
        "class_name": "AxeCloudApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AxeCloudApiContainer"]
    }
  ]
}