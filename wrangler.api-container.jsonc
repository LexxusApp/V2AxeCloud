{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axecloud-api-staging",
  "main": "cloudflare/api-container-worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "containers": [
    {
      "class_name": "AxeCloudApiContainer",
      "image": "./Dockerfile.cloudflare-api",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AXECLOUD_API_CONTAINER",
        "class_name": "AxeCloudApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AxeCloudApiContainer"]
    }
  ]
}